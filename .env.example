# Database Configuration (Supabase PostgreSQL or Local PostgreSQL)
# For Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_management?schema=public"

# Direct connection to the database (used for migrations by Prisma)
# For Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/school_management?schema=public"

# Supabase Auth / Storage (optional if using internal JWT auth)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Backend Configuration
PORT=4000
NODE_ENV="development"
JWT_SECRET="super-secret-jwt-key-school-mgmt-system-production-2026"
JWT_EXPIRES_IN="7d"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Initial Admin Credentials (Section 2 & 36)
INITIAL_ADMIN_EMAIL="admin@gmail.com"
INITIAL_ADMIN_PASSWORD="CHANGE_THIS_IN_PRODUCTION"
